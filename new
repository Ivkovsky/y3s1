  {s:"IC", t:"Infect disease related dent", h:1},
  {s:"IC", t:"Control of microorg by phy", h:1},
  {s:"IC", t:"Sterile by heat", h:1},
  {s:"IC", t:"Control of microor by chem", h:2},
  {s:"IC", t:"physical lab", h:0, practical:true},
  {s:"IC", t:"chemical lab", h:0, practical:true},

  // 22/9 — Exam Assess (15)
  {s:"Exam Assess", t:"Case history", h:1},
  {s:"Exam Assess", t:"Types of exam", h:1},
  {s:"Exam Assess", t:"Medico-dent relation", h:1, clip:true},
  {s:"Exam Assess", t:"Symp and signs I-II", h:2},
  {s:"Exam Assess", t:"Clinical oral soft tiss exam I", h:1},
  {s:"Exam Assess", t:"Clinical oral soft tiss exam II", h:1},
  {s:"Exam Assess", t:"General phy and neuro exam I-II", h:2},
  {s:"Exam Assess", t:"General phy and neuro exam III", h:1},
  {s:"Exam Assess", t:"Exam of teeth,bone,tmj I", h:1},
  {s:"Exam Assess", t:"Exam of teeth,bone,tmj II", h:1, classDate:"8/9"},
  {s:"Exam Assess", t:"Exam of teeth,bone,tmj III", h:1, classDate:"8/9"},
  {s:"Exam Assess", t:"Exam of teeth,bone,tmj IV-V", h:2, classDate:"15/9"},

  // 23/9 — Dent cario I (15)
  {s:"Dent cario I", t:"Saliva comp & func", h:1},
  {s:"Dent cario I", t:"Biochem of acq pellicle & dent biofilm", h:1},
  {s:"Dent cario I", t:"Oral biofilm", h:1},
