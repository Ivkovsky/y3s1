<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Dental Midterm Priority Board</title>
<style>
  :root{
    --ink:#17191f;
    --muted:#6e7481;
    --paper:#f3efe8;
    --panel:#fffdf9;
    --line:#d8d2c8;
    --shadow:0 12px 30px rgba(31, 35, 43, .10);
    --radius:20px;
  }
  *{box-sizing:border-box}
  html,body{min-height:100%;margin:0}
  body{
    font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color:var(--ink);
    background:
      radial-gradient(circle at 18% 8%, rgba(255,255,255,.9), transparent 24rem),
      linear-gradient(135deg,#ece8df 0%,#f8f4ed 52%,#ebe6dc 100%);
  }
  button,input,select{font:inherit}
  button{cursor:pointer}
  .app{max-width:1900px;margin:0 auto;padding:12px 18px 28px}

  .hero{
    background:rgba(255,253,249,.88);
    border:1px solid rgba(130,120,105,.16);
    box-shadow:var(--shadow);
    border-radius:20px;
    padding:12px 16px 10px;
    backdrop-filter: blur(14px);
    position:relative;z-index:50;
  }
  .hero-top{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
  .eyebrow{font-size:.64rem;letter-spacing:.13em;text-transform:uppercase;font-weight:800;color:#7b7060;margin-bottom:3px}
  h1{font-family:Georgia,"Times New Roman",serif;font-size:clamp(1.7rem,2.4vw,2.35rem);line-height:.98;margin:0 0 4px;letter-spacing:-.035em}
  .subtitle{margin:0;color:var(--muted);font-size:.78rem;max-width:930px;line-height:1.35}
  .date-chip{white-space:nowrap;border:1px solid #d2cabf;background:#fffaf0;border-radius:999px;padding:7px 11px;font-size:.72rem;font-weight:800}

  .stats{display:grid;grid-template-columns:repeat(4,minmax(145px,1fr));gap:8px;margin-top:9px}
  .stat{background:#fff;border:1px solid #e3ddd4;border-radius:12px;padding:7px 10px;min-height:54px}
  .stat-label{font-size:.60rem;text-transform:uppercase;letter-spacing:.08em;color:#817a70;font-weight:800}
  .stat-value{font-family:Georgia,"Times New Roman",serif;font-size:1.18rem;font-weight:700;margin-top:1px;line-height:1.05}
  .stat-foot{font-size:.60rem;color:#8a8f98;margin-top:1px}
  .progress-track{height:5px;background:#e8e3da;border-radius:999px;overflow:hidden;margin-top:5px}
  .progress-fill{height:100%;width:0;background:#222;border-radius:999px;transition:width .25s ease}

  .tools{display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin-top:8px;padding-top:8px;border-top:1px dashed #d8d1c7}
  .search{flex:1;min-width:210px;position:relative}
  .search input{width:100%;border:1px solid #d6d0c8;border-radius:10px;padding:7px 10px 7px 31px;background:#fff;outline:none;font-size:.78rem}
  .search:before{content:"⌕";position:absolute;left:10px;top:4px;font-size:1rem;color:#7c828d}
  select,.tool-btn{border:1px solid #d6d0c8;background:#fff;border-radius:10px;padding:7px 9px;color:#30333a;font-size:.76rem}
  .tool-btn:hover,select:hover{border-color:#aaa195}
  .tool-btn.danger{color:#9c3a32}
  .tiny-help{font-size:.64rem;color:#7a7f88;margin-left:auto}

  .legend{display:flex;gap:5px;flex-wrap:wrap;margin:8px 0 2px}
  .legend-chip{border:0;border-radius:999px;padding:4px 7px;font-size:.62rem;font-weight:800;color:#353535;box-shadow:inset 0 0 0 1px rgba(0,0,0,.06)}
  .legend-chip.active{outline:2px solid #222;outline-offset:1px}

  .board-wrap{overflow-x:auto;padding:9px 2px 16px}
  .board{display:grid;grid-template-columns:repeat(5,minmax(250px,1fr));gap:10px;min-width:1300px;align-items:start}
  .column{background:rgba(255,255,255,.60);border:1px solid rgba(135,125,110,.20);border-radius:16px;min-height:72vh;box-shadow:0 7px 22px rgba(40,42,46,.05);overflow:hidden}
  .column.drag-over{outline:3px dashed #6c6f75;outline-offset:-6px;background:rgba(255,255,255,.86)}
  .col-head{position:relative;top:auto;z-index:10;background:rgba(248,246,241,.98);padding:9px 10px 8px;border-bottom:1px solid #ddd7ce}
  .col-head-row{display:flex;justify-content:space-between;align-items:center;gap:8px}
  .col-num{width:23px;height:23px;border-radius:50%;display:grid;place-items:center;background:#222;color:#fff;font-size:.66rem;font-weight:900;flex:0 0 auto}
  .col-title{font-family:Georgia,"Times New Roman",serif;font-size:.90rem;font-weight:700;line-height:1.05;flex:1}
  .col-count{font-size:.61rem;font-weight:800;color:#555b65;background:white;border:1px solid #ded8cf;border-radius:999px;padding:3px 6px}
  .col-sub{font-size:.60rem;color:#7c8189;margin-top:3px;padding-left:30px}
  .cards{padding:8px;display:flex;flex-direction:column;gap:7px;min-height:61vh}

  .sticky{
    --note:#fff1a8;
    --note-dark:#e5d17c;
    background:var(--note);
    border:1px solid color-mix(in srgb, var(--note-dark) 70%, #777 30%);
    border-radius:7px 7px 12px 7px;
    padding:8px 9px 7px;
    box-shadow:0 6px 11px rgba(35,38,45,.10), inset 0 -12px 22px rgba(255,255,255,.12);
    position:relative;
    transition:transform .16s ease, box-shadow .16s ease, opacity .16s ease;
    cursor:grab;
  }
  .sticky:nth-child(3n+1){transform:rotate(-.35deg)}
  .sticky:nth-child(3n+2){transform:rotate(.25deg)}
  .sticky:hover{transform:translateY(-2px) rotate(0deg);box-shadow:0 9px 16px rgba(35,38,45,.14)}
  .sticky.dragging{opacity:.45;transform:rotate(2deg) scale(.98)}
  .sticky:after{content:"";position:absolute;right:0;bottom:0;width:24px;height:24px;background:linear-gradient(135deg,transparent 50%,rgba(255,255,255,.42) 50%);border-radius:0 0 13px 0;pointer-events:none}
  .note-top{display:flex;justify-content:space-between;gap:8px;align-items:flex-start}
  .subject{font-size:.58rem;text-transform:uppercase;letter-spacing:.075em;font-weight:900;line-height:1.2}
  .hours{font-size:.57rem;font-weight:900;background:rgba(255,255,255,.55);border:1px solid rgba(0,0,0,.08);border-radius:999px;padding:2px 5px;white-space:nowrap}
  .lecture{font-weight:760;font-size:.77rem;line-height:1.16;margin:5px 0 5px;letter-spacing:-.008em}
  .meta{display:flex;gap:4px;flex-wrap:wrap;align-items:center;font-size:.55rem;color:#4f535b}
  .meta span{background:rgba(255,255,255,.40);padding:2px 4px;border-radius:4px}
  .note-actions{display:flex;justify-content:space-between;gap:5px;margin-top:5px;padding-top:5px;border-top:1px dashed rgba(0,0,0,.14)}
  .move-btn{border:0;background:rgba(255,255,255,.52);border-radius:6px;padding:3px 6px;font-size:.57rem;font-weight:800;color:#3d424a}
  .move-btn:hover{background:rgba(255,255,255,.76)}
  .move-btn:disabled{opacity:.25;cursor:not-allowed}
  .practical-badge{background:#222 !important;color:#fff !important;font-weight:900;letter-spacing:.04em}

  .empty{border:2px dashed #d2ccc3;border-radius:10px;padding:18px 10px;text-align:center;color:#9a968e;font-size:.7rem;background:rgba(255,255,255,.3)}

  .footer{display:flex;justify-content:space-between;gap:20px;align-items:center;color:#777d86;font-size:.66rem;padding:2px 4px 14px;flex-wrap:wrap}
  .footer strong{color:#30333a}


  @media (min-width:1200px){
    .hero-top > div:first-child{display:grid;grid-template-columns:auto auto;column-gap:14px;align-items:end}
    .hero-top .eyebrow{grid-column:1 / -1}
    .hero-top h1{margin-bottom:0}
    .hero-top .subtitle{align-self:center;margin-top:3px}
  }

  @media (max-width:900px){
    .app{padding:12px}
    .hero{padding:12px 12px;position:relative}
    .stats{grid-template-columns:repeat(2,1fr)}
    .col-head{top:auto}
    .tiny-help{width:100%;margin-left:0}
  }
  @media (max-width:520px){
    .stats{grid-template-columns:1fr 1fr;gap:7px}
    .stat{padding:8px;min-height:54px}
    .subtitle{font-size:.76rem}
  }
</style>
</head>
<body>
<div class="app">
  <section class="hero">
    <div class="hero-top">
      <div>
        <div class="eyebrow">Dental Y3 · Midterm Study System</div>
        <h1>Priority Board</h1>
        <p class="subtitle">Drag each lecture from <b>Haven’t Learned</b> → <b>Learned in Class</b> → three review rounds. Sticky-note colors are locked to subjects, and your progress is saved automatically on this device.</p>
      </div>
      <div class="date-chip">Exam week · 21–25 Sep</div>
    </div>

    <div class="stats">
      <div class="stat"><div class="stat-label">Lecture load</div><div class="stat-value" id="totalHours">106 h</div><div class="stat-foot">From the midterm list</div></div>
      <div class="stat"><div class="stat-label">Still unlearned</div><div class="stat-value" id="unlearnedHours">106 h</div><div class="stat-foot" id="unlearnedNotes">— lecture notes</div></div>
      <div class="stat"><div class="stat-label">Review #3 complete</div><div class="stat-value" id="finishedHours">0 h</div><div class="stat-foot">Fully through the pipeline</div></div>
      <div class="stat"><div class="stat-label">Pipeline progress</div><div class="stat-value" id="pipelinePct">0%</div><div class="progress-track"><div class="progress-fill" id="progressFill"></div></div></div>
    </div>

    <div class="tools">
      <div class="search"><input id="searchInput" type="search" placeholder="Search lecture, subject, date…" /></div>
      <select id="subjectFilter"><option value="all">All subjects</option></select>
      <select id="sortSelect" title="Sort notes in each column">
        <option value="exam">Sort: exam order</option>
        <option value="subject">Sort: subject</option>
        <option value="hours">Sort: longest first</option>
      </select>
      <button class="tool-btn" id="exportBtn">Export progress</button>
      <button class="tool-btn danger" id="resetBtn">Reset board</button>
      <div class="tiny-help">Desktop: drag notes · Mobile: use ← / → buttons</div>
    </div>

    <div class="legend" id="legend"></div>
  </section>

  <div class="board-wrap">
    <main class="board" id="board"></main>
  </div>

  <div class="footer">
    <span><strong>Tip:</strong> filter one subject before a study session so the board becomes your immediate priority list.</span>
    <span>106 lecture hours + 3 practical reminders</span>
  </div>
</div>

<script>
const STAGES = [
  {id:"unlearned", title:"Haven’t Learned", sub:"Start here · content not learned yet"},
  {id:"learned", title:"Learned in Class", sub:"Understood once in lecture/class"},
  {id:"review1", title:"Review #1", sub:"First active recall / consolidation"},
  {id:"review2", title:"Review #2", sub:"Second spaced review"},
  {id:"review3", title:"Review #3", sub:"Final review completed"}
];

const SUBJECTS = {
  "Oper dent": {note:"#FFD89A", dark:"#D59D4A", exam:"21 Sep", order:1},
  "Func Occl": {note:"#BDE4FF", dark:"#78B4D9", exam:"22 Sep", order:2},
  "IC": {note:"#CFE7C3", dark:"#8AB776", exam:"22 Sep", order:3},
  "Exam Assess": {note:"#F7C4D5", dark:"#D884A2", exam:"22 Sep", order:4},
  "Dent cario I": {note:"#FFF0A8", dark:"#DCCB64", exam:"23 Sep", order:5},
  "Pain/Anxie": {note:"#D8C7F2", dark:"#A98DD1", exam:"23 Sep", order:6},
  "Abdis": {note:"#FFC6A8", dark:"#D78D66", exam:"24 Sep", order:7},
  "Gen Med I": {note:"#BCE7E3", dark:"#6EBAB3", exam:"24 Sep", order:8},
  "Dent Mat II": {note:"#C9D8FF", dark:"#8199D8", exam:"25 Sep", order:9},
  "Oral Epi": {note:"#E9D6B8", dark:"#BE9967", exam:"25 Sep", order:10},
