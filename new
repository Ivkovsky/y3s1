  {s:"Oper dent", t:"Intro to resin comp rest I", h:1, classDate:"7/9"},
  {s:"Oper dent", t:"Intro to resin comp rest II", h:1, classDate:"14/9"},
  {s:"Oper dent", t:"Oper dent lab", h:0, practical:true},

  // 22/9 — Func Occl (6)
