  // 25/9 — Dent Mat II (7)
  {s:"Dent Mat II", t:"Resin comp restore", h:1},
  {s:"Dent Mat II", t:"Amalgam restore", h:1},
  {s:"Dent Mat II", t:"Light Act unit", h:1},
  {s:"Dent Mat II", t:"Fluo releasing mat I : GIC", h:1},
  {s:"Dent Mat II", t:"Fluo releasing mat II : Giomer,Comp", h:1, classDate:"3/9"},
  {s:"Dent Mat II", t:"Pulp protect mat", h:1, classDate:"10/9"},
  {s:"Dent Mat II", t:"Gingival retract mat", h:1, classDate:"17/9"},

  // 25/9 — Oral Epi (6)
  {s:"Oral Epi", t:"Def,scope oral epi", h:1},
  {s:"Oral Epi", t:"Epi of coronal caries I : measure&distri", h:1},
  {s:"Oral Epi", t:"Epi of coronal caries II : measure&distri", h:1},
  {s:"Oral Epi", t:"Epi of dev defect of dent enamel", h:1},
  {s:"Oral Epi", t:"Epi of fluorosis", h:1, classDate:"4/9"},
  {s:"Oral Epi", t:"Epi of root caries&tooth loss", h:1, classDate:"11/9"},

  // 25/9 — Perio I (6)
  {s:"Perio I", t:"Perio in health&disease", h:1},
  {s:"Perio I", t:"Gingivitis & perio I", h:1},
  {s:"Perio I", t:"Gingivitis & perio II", h:1},
  {s:"Perio I", t:"Perio homeo", h:1, classDate:"2/9"},
  {s:"Perio I", t:"Immunopatho of perio disease", h:1, classDate:"9/9"},
  {s:"Perio I", t:"Etiology : plaque biofilm", h:1, classDate:"16/9"}
].map((x,i)=>({...x,id:`L${String(i+1).padStart(3,"0")}`,stage:"unlearned",seq:i}));

const STORAGE_KEY = "dental-midterm-priority-board-v1";
let state = loadState();
let activeSubject = "all";
let searchTerm = "";
let sortMode = "exam";
let draggedId = null;

function loadState(){
  try{
    const saved = JSON.parse(localStorage.getItem(STORAGE_KEY));
    if(!saved) return Object.fromEntries(lectures.map(l=>[l.id,"unlearned"]));
    const clean = {};
    lectures.forEach(l=>clean[l.id] = STAGES.some(s=>s.id===saved[l.id]) ? saved[l.id] : "unlearned");
    return clean;
  }catch(e){return Object.fromEntries(lectures.map(l=>[l.id,"unlearned"]));}
}
function save(){localStorage.setItem(STORAGE_KEY,JSON.stringify(state));}

function setup(){
  const filter = document.getElementById("subjectFilter");
  Object.keys(SUBJECTS).forEach(s=>{
    const opt=document.createElement("option");opt.value=s;opt.textContent=s;filter.appendChild(opt);
  });
  const legend=document.getElementById("legend");
  Object.entries(SUBJECTS).forEach(([name,cfg])=>{
    const b=document.createElement("button");
    b.className="legend-chip";b.textContent=name;b.style.background=cfg.note;
    b.onclick=()=>{activeSubject=activeSubject===name?"all":name;filter.value=activeSubject;render();};
    b.dataset.subject=name;legend.appendChild(b);
  });

  document.getElementById("searchInput").addEventListener("input",e=>{searchTerm=e.target.value.trim().toLowerCase();render();});
  filter.addEventListener("change",e=>{activeSubject=e.target.value;render();});
  document.getElementById("sortSelect").addEventListener("change",e=>{sortMode=e.target.value;render();});
  document.getElementById("resetBtn").onclick=()=>{
    if(confirm("Reset every sticky note back to Haven’t Learned?")){
      state=Object.fromEntries(lectures.map(l=>[l.id,"unlearned"]));save();render();
    }
  };
  document.getElementById("exportBtn").onclick=exportProgress;
  render();
}

function filteredLectures(){
  return lectures.filter(l=>{
    const subjectOk=activeSubject==="all"||l.s===activeSubject;
    const hay=`${l.t} ${l.s} ${SUBJECTS[l.s].exam} ${l.classDate||""}`.toLowerCase();
    return subjectOk && (!searchTerm || hay.includes(searchTerm));
  });
}

function sortLectures(list){
  return [...list].sort((a,b)=>{
    if(sortMode==="hours") return (b.h-a.h)||(SUBJECTS[a.s].order-SUBJECTS[b.s].order)||(a.seq-b.seq);
    if(sortMode==="subject") return a.s.localeCompare(b.s)||(a.seq-b.seq);
    return (SUBJECTS[a.s].order-SUBJECTS[b.s].order)||(a.seq-b.seq);
  });
}

function render(){
  document.querySelectorAll(".legend-chip").forEach(x=>x.classList.toggle("active",x.dataset.subject===activeSubject));
  const board=document.getElementById("board");board.innerHTML="";
  const visible=filteredLectures();

  STAGES.forEach((stage,stageIndex)=>{
    const col=document.createElement("section");
    col.className="column";col.dataset.stage=stage.id;
    col.innerHTML=`<div class="col-head"><div class="col-head-row"><span class="col-num">${stageIndex+1}</span><div class="col-title">${stage.title}</div><span class="col-count" id="count-${stage.id}"></span></div><div class="col-sub">${stage.sub}</div></div><div class="cards" data-drop="${stage.id}"></div>`;
    const cards=col.querySelector(".cards");
    const list=sortLectures(visible.filter(l=>state[l.id]===stage.id));
    list.forEach(l=>cards.appendChild(makeCard(l,stageIndex)));
    if(!list.length){const e=document.createElement("div");e.className="empty";e.textContent="Drop notes here";cards.appendChild(e);}

    [col,cards].forEach(target=>{
      target.addEventListener("dragover",e=>{e.preventDefault();col.classList.add("drag-over")});
      target.addEventListener("dragleave",e=>{if(!col.contains(e.relatedTarget)) col.classList.remove("drag-over")});
      target.addEventListener("drop",e=>{
        e.preventDefault();col.classList.remove("drag-over");
        if(draggedId){state[draggedId]=stage.id;save();draggedId=null;render();}
      });
    });
    board.appendChild(col);
  });
  updateStats();
}

function makeCard(l,stageIndex){
  const cfg=SUBJECTS[l.s];
  const el=document.createElement("article");
  el.className="sticky";el.draggable=true;el.dataset.id=l.id;
  el.style.setProperty("--note",cfg.note);el.style.setProperty("--note-dark",cfg.dark);
  const hourLabel=l.practical?"LAB":`${l.h}h`;
  el.innerHTML=`
    <div class="note-top"><span class="subject">${escapeHtml(l.s)}</span><span class="hours">${hourLabel}</span></div>
    <div class="lecture">${escapeHtml(l.t)}</div>
    <div class="meta">
      <span>Exam ${cfg.exam}</span>
      ${l.classDate?`<span>Class ${escapeHtml(l.classDate)}</span>`:""}
      ${l.clip?`<span>clip</span>`:""}
      ${l.practical?`<span class="practical-badge">PRACTICAL</span>`:""}
    </div>
    <div class="note-actions">
      <button class="move-btn prev" ${stageIndex===0?"disabled":""}>← Back</button>
      <button class="move-btn next" ${stageIndex===STAGES.length-1?"disabled":""}>Next →</button>
    </div>`;
  el.addEventListener("dragstart",()=>{draggedId=l.id;el.classList.add("dragging")});
  el.addEventListener("dragend",()=>{draggedId=null;el.classList.remove("dragging");document.querySelectorAll(".column").forEach(c=>c.classList.remove("drag-over"))});
  el.querySelector(".prev").onclick=e=>{e.stopPropagation();moveRelative(l.id,-1)};
  el.querySelector(".next").onclick=e=>{e.stopPropagation();moveRelative(l.id,1)};
  return el;
}

function moveRelative(id,delta){
  const idx=STAGES.findIndex(s=>s.id===state[id]);
  const next=Math.max(0,Math.min(STAGES.length-1,idx+delta));
  state[id]=STAGES[next].id;save();render();
}

function updateStats(){
  const totalLectureHours=lectures.reduce((sum,l)=>sum+l.h,0);
  const hoursAt=stage=>lectures.filter(l=>state[l.id]===stage&&!l.practical).reduce((sum,l)=>sum+l.h,0);
  const notesAt=stage=>lectures.filter(l=>state[l.id]===stage).length;
  document.getElementById("totalHours").textContent=`${totalLectureHours} h`;
  document.getElementById("unlearnedHours").textContent=`${hoursAt("unlearned")} h`;
  document.getElementById("unlearnedNotes").textContent=`${notesAt("unlearned")} sticky notes`;
  document.getElementById("finishedHours").textContent=`${hoursAt("review3")} h`;
  const weights={unlearned:0,learned:.25,review1:.5,review2:.75,review3:1};
  const weighted=lectures.filter(l=>!l.practical).reduce((sum,l)=>sum+l.h*weights[state[l.id]],0);
  const pct=Math.round(weighted/totalLectureHours*100);
  document.getElementById("pipelinePct").textContent=`${pct}%`;
  document.getElementById("progressFill").style.width=`${pct}%`;
  STAGES.forEach(s=>{
    const el=document.getElementById(`count-${s.id}`); if(!el)return;
    const vis=filteredLectures().filter(l=>state[l.id]===s.id);
    const hrs=vis.reduce((sum,l)=>sum+l.h,0);
    el.textContent=`${vis.length} · ${hrs}h`;
  });
}

function exportProgress(){
  const rows=lectures.map(l=>({subject:l.s,lecture:l.t,hours:l.h,exam:SUBJECTS[l.s].exam,class_date:l.classDate||"",clip:!!l.clip,practical:!!l.practical,stage:STAGES.find(s=>s.id===state[l.id]).title}));
  const payload={exported:new Date().toISOString(),lecture_hours:106,progress:rows};
  const blob=new Blob([JSON.stringify(payload,null,2)],{type:"application/json"});
  const url=URL.createObjectURL(blob);const a=document.createElement("a");a.href=url;a.download="dental-midterm-study-progress.json";a.click();URL.revokeObjectURL(url);
}

function escapeHtml(str){return String(str).replace(/[&<>'"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;","'":"&#39;",'"':"&quot;"}[c]));}
setup();
</script>
</body>
